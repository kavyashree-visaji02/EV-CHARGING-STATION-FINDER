
FROM python:3.11-slim

WORKDIR /app

RUN groupadd --system appgroup && \
    useradd --system --gid appgroup --create-home appuser

COPY --chown=appuser:appgroup charger_search.py distance.py reservation.py stations.py test_reservation.py test_search.py ./

USER appuser

CMD ["python", "-m", "unittest", "discover", "-v"]
